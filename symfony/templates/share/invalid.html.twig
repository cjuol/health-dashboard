<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enlace no disponible · cjuol</title>
    {% include '_partials/styles.html.twig' %}
    <style>
        body { min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    </style>
</head>
<body>
<div class="panel" style="width:100%; max-width:360px; text-align:center">
    <h2>Enlace no válido o caducado</h2>
