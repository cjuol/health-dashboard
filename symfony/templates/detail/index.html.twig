{% extends 'base.html.twig' %}
{% block title %}Detalle · {{ metric }}{% endblock %}

{% block body %}
<form class="inline panel" method="get">
    <nav style="display:flex; gap:.4rem; margin-right:auto">
        {% for m in metrics %}
        <a href="{{ path('detail', {metric: m}) }}?desde={{ from|date('Y-m-d') }}&hasta={{ to|date('Y-m-d') }}"
           style="padding:.35rem .7rem; border-radius:6px; text-decoration:none;
                  {{ m == metric ? 'background:var(--green); color:var(--bg); font-weight:600' : 'color:var(--muted)' }}">
            {{ {pasos: 'Pasos', sueno: 'Sueño', cuerpo: 'Cuerpo', carga: 'Carga'}[m] }}</a>
        {% endfor %}
    </nav>
    <label>Desde <input type="date" name="desde" value="{{ from|date('Y-m-d') }}"></label>
    <label>Hasta <input type="date" name="hasta" value="{{ to|date('Y-m-d') }}"></label>
    <button type="submit">Aplicar</button>
</form>

{% if metric == 'pasos' %}
<div class="panel"><h2>Pasos por fuente</h2><canvas id="ch1"></canvas></div>
<div class="panel">
    <h2>Mapa de calor: pasos por hora y día <span class="muted" style="font-weight:400">(azul = Garmin, amarillo = móvil — tus turnos se pintan solos)</span></h2>
    <div style="overflow-x:auto">
    <table style="border-collapse:separate; border-spacing:2px; font-size:.7rem">
        <tr><th></th>{% for h in 0..23 %}<th class="muted" style="padding:1px 2px; border:0">{{ h }}</th>{% endfor %}</tr>
        {% for day, hours in data.heatmap.rows %}
        <tr>
            <td class="muted" style="border:0; padding:1px 6px 1px 0; white-space:nowrap">{{ day|date('d/m') }}</td>
            {% for h in 0..23 %}
                {% set cell = hours[h] ?? null %}
                {% if cell and cell.steps > 0 %}
                    {% set alpha = 0.15 + 0.85 * (cell.steps / data.heatmap.max) %}
                    {% set isPhone = (cell.phone_steps ?? 0) >= (cell.garmin_steps ?? 0) %}
                    <td title="{{ day }} {{ h }}h: {{ cell.steps }} pasos ({{ isPhone ? 'móvil' : 'Garmin' }})"
                        style="width:22px; height:16px; border:0; border-radius:2px; padding:0;
                               background: rgba({{ isPhone ? '196,178,138' : '139,164,176' }}, {{ alpha|round(2) }})"></td>
                {% else %}
                    <td style="width:22px; height:16px; border:0; border-radius:2px; padding:0; background:var(--bg2)"></td>
                {% endif %}
            {% endfor %}
        </tr>
        {% endfor %}
    </table>
    </div>
</div>
{% elseif metric == 'sueno' %}
<div class="grid2">
    <div class="panel"><h2>Fases y score</h2><canvas id="ch1"></canvas></div>
    <div class="panel"><h2>Respiración y SpO2 nocturnos</h2><canvas id="ch2"></canvas></div>
</div>
{% elseif metric == 'cuerpo' %}
<div class="grid2">
    <div class="panel"><h2>Peso</h2><canvas id="ch1"></canvas></div>
    <div class="panel"><h2>% grasa y masa muscular</h2><canvas id="ch2"></canvas></div>
</div>
{% elseif metric == 'carga' %}
<div class="grid2">
    <div class="panel"><h2>FC reposo y estrés medio</h2><canvas id="ch1"></canvas></div>
    <div class="panel"><h2>HRV</h2><canvas id="ch2"></canvas></div>
</div>
<div class="panel"><h2>Minutos de intensidad / semana</h2><canvas id="ch3" style="max-height:220px"></canvas></div>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
const D = {{ data|json_encode|raw }};
const M = '{{ metric }}';
const C = { green:'#8a9a7b', yellow:'#c4b28a', blue:'#8ba4b0', red:'#c4746e', muted:'#737c73',
            deep:'#4a6d8c', light:'#8ba4b0', rem:'#8a9a7b', awake:'#c4746e' };
Chart.defaults.color = '#c5c9c5'; Chart.defaults.borderColor = '#393836';

if (M === 'pasos') {
    const days = D.by_source.map(r => r.day.slice(5));
    const goal = Object.fromEntries(D.daily.map(r => [r.day, +r.daily_goal]));
    new Chart(ch1, { options: { scales: { x: { stacked: true }, y: { stacked: true } } }, data: {
        labels: days,
        datasets: [
            { type: 'bar', label: 'Garmin', data: D.by_source.map(r => +r.garmin_steps || 0), backgroundColor: C.blue },
            { type: 'bar', label: 'Móvil',  data: D.by_source.map(r => +r.phone_steps || 0), backgroundColor: C.yellow },
            { type: 'line', label: 'Objetivo', data: D.by_source.map(r => goal[r.day] ?? null),
              borderColor: C.green, pointRadius: 0, stepped: true },
        ]}});
}
if (M === 'sueno') {
    const days = D.sleep.map(r => r.day.slice(5));
    const ph = k => D.sleep.map(r => r[k] ? +(r[k]/3600).toFixed(2) : null);
    new Chart(ch1, { options: { scales: { x:{stacked:true}, y:{stacked:true,min:0,max:10}, y2:{position:'right',min:0,max:100,grid:{display:false}} } }, data: {
        labels: days,
        datasets: [
            { type:'bar', label:'Profundo', data: ph('deep_s'),  backgroundColor: C.deep },
            { type:'bar', label:'Ligero',   data: ph('light_s'), backgroundColor: C.light },
            { type:'bar', label:'REM',      data: ph('rem_s'),   backgroundColor: C.rem },
            { type:'bar', label:'Despierto',data: ph('awake_s'), backgroundColor: C.awake },
            { type:'line', label:'Score', data: D.sleep.map(r => r.score), borderColor: C.yellow, yAxisID:'y2', pointRadius:2 },
        ]}});
    new Chart(ch2, { type:'line', options:{ scales:{ y2:{position:'right',min:85,max:100,grid:{display:false}} } }, data: {
        labels: days,
        datasets: [
            { label:'Respiración (rpm)', data: D.sleep.map(r => r.respiration_avg ? +r.respiration_avg : null), borderColor: C.blue, pointRadius:2, spanGaps:true },
            { label:'SpO2 %', data: D.sleep.map(r => r.spo2_avg ? +r.spo2_avg : null), borderColor: C.green, yAxisID:'y2', pointRadius:2, spanGaps:true },
        ]}});
}
if (M === 'cuerpo') {
    const days = D.body.map(r => r.day.slice(5));
    const peso = D.body.map(r => r.weight_kg ? +r.weight_kg : null);
    const ma7 = peso.map((_, i) => { const w = peso.slice(Math.max(0,i-6), i+1).filter(v => v !== null);
        return w.length >= 3 ? +(w.reduce((a,b)=>a+b,0)/w.length).toFixed(2) : null; });
    new Chart(ch1, { type:'line', data: { labels: days, datasets: [
        { label:'kg (día)', data: peso, borderColor: C.muted, pointRadius:2, borderWidth:1, spanGaps:true },
        { label:'Tendencia 7d', data: ma7, borderColor: C.yellow, pointRadius:0, borderWidth:2.5, spanGaps:true }]}});
    new Chart(ch2, { type:'line', options:{ scales:{ y2:{position:'right',grid:{display:false}} } }, data: { labels: days, datasets: [
        { label:'% grasa', data: D.body.map(r => r.body_fat_pct ? +r.body_fat_pct : null), borderColor: C.red, pointRadius:2, spanGaps:true },
        { label:'Músculo kg', data: D.body.map(r => r.muscle_mass_kg ? +r.muscle_mass_kg : null), borderColor: C.green, yAxisID:'y2', pointRadius:2, spanGaps:true }]}});
}
if (M === 'carga') {
    const days = D.daily.map(r => r.day.slice(5));
    new Chart(ch1, { type:'line', options:{ scales:{ y2:{position:'right',min:0,max:100,grid:{display:false}} } }, data: { labels: days, datasets: [
        { label:'FC reposo', data: D.daily.map(r => r.resting_hr), borderColor: C.red, pointRadius:2, spanGaps:true },
        { label:'Estrés medio', data: D.daily.map(r => r.avg_stress), borderColor: C.yellow, yAxisID:'y2', pointRadius:2, spanGaps:true }]}});
    const hd = Object.fromEntries(D.hrv.map(r => [r.day, r]));
    const hv = k => D.daily.map(r => hd[r.day] ? hd[r.day][k] : null);
    new Chart(ch2, { type:'line', data: { labels: days, datasets: [
        { label:'Base alta', data: hv('baseline_high_ms'), borderColor:'transparent', backgroundColor:'rgba(138,154,123,.15)', fill:'+1', pointRadius:0 },
        { label:'Base baja', data: hv('baseline_low_ms'), borderColor:'transparent', pointRadius:0 },
        { label:'HRV', data: hv('last_night_avg_ms'), borderColor: C.green, pointRadius:3 }]},
        options:{ plugins:{ legend:{ labels:{ filter: i => i.text === 'HRV' } } } }});
    new Chart(ch3, { type:'bar', options:{ scales:{ x:{stacked:true}, y:{stacked:true} } }, data: {
        labels: D.intensity.map(r => r.week_start.slice(5)),
        datasets: [
            { label:'Moderados', data: D.intensity.map(r => +r.moderate), backgroundColor: C.blue },
            { label:'Vigorosos ×2', data: D.intensity.map(r => +r.vigorous2), backgroundColor: C.green }]}});
}
</script>
{% endblock %}
