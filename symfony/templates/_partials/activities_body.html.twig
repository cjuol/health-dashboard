{# Cuerpo del listado de actividades, compartido entre activity/index.html.twig
   (propietario) y share/activities.html.twig (invitado). El formulario GET no
   lleva action explícito a propósito: reenvía a la URL actual (propietario o
   invitado) preservando el prefijo /compartir/{token} sin parametrizarlo aquí.

   Variables esperadas: from, to, type, types, activities, routes.activity_show, route_params
#}
<form class="inline panel" method="get">
    <label>Desde <input type="date" name="desde" value="{{ from|date('Y-m-d') }}"></label>
    <label>Hasta <input type="date" name="hasta" value="{{ to|date('Y-m-d') }}"></label>
    <label>Tipo
        <select name="tipo" style="background:var(--bg2); color:var(--fg); border:1px solid var(--border); border-radius:6px; padding:.45rem .6rem">
            <option value="">Todos</option>
            {% for t in types %}<option value="{{ t }}" {{ t == type ? 'selected' }}>{{ t }}</option>{% endfor %}
        </select>
    </label>
    <button type="submit">Filtrar</button>
</form>

<div class="panel">
    <h2>{{ activities|length }} sesiones</h2>
    <table>
        <tr>
            <th>Fecha</th><th>Tipo</th><th>Sesión</th><th>Dur.</th><th>Dist.</th>
            <th>FC media</th><th>kcal</th>
        </tr>
        {% for a in activities %}
        {% set isSwim = 'swim' in a.activity_type %}
        <tr>
            <td>{{ a.start_time|date('d/m H:i') }}</td>
            <td>{{ a.is_strength ? '🏋' : (isSwim ? '🏊' : '🏃') }} {{ a.activity_type }}</td>
            <td><a href="{{ path(routes.activity_show, route_params|merge({id: a.activity_id})) }}" style="color:var(--link)">{{ a.activity_name }}</a></td>
            <td>{{ a.duration_s ? (a.duration_s / 60)|round ~ "'" : '—' }}</td>
            <td>{{ a.distance_m ? (a.distance_m / 1000)|number_format(2, ',') ~ ' km' : '—' }}</td>
            <td>{{ a.avg_hr ?? '—' }}</td>
            <td>{{ a.calories ?? '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="muted">Sin sesiones en el rango.</td></tr>
        {% endfor %}
    </table>
</div>
