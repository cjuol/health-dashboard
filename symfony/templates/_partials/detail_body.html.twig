{# Cuerpo de las vistas de detalle, compartido entre detail/index.html.twig
   (propietario) y share/detail.html.twig (invitado). El formulario GET no
   lleva action explícito a propósito: reenvía a la URL actual preservando
   el prefijo /compartir/{token} sin parametrizarlo aquí. Las pestañas de
   métrica sí necesitan la ruta correcta (propietario vs invitado).

   Variables esperadas: metric, metrics, from, to, data, routes.detail, route_params
   Para metric == 'pasos', data también trae step_days: filas por día
   (day, phone_steps, garmin_steps, phone_distance_m, daily_goal, pct_goal,
   goal_met) ya fusionadas en el controlador a partir de
   dailySteps()+dailyStepsBySource(), más recientes primero — usadas por la
   lista junto al heatmap.
#}
<form class="inline panel" method="get">
    <nav style="display:flex; gap:.4rem; margin-right:auto">
        {% for m in metrics %}
        <a href="{{ path(routes.detail, route_params|merge({metric: m, desde: from|date('Y-m-d'), hasta: to|date('Y-m-d')})) }}"
           style="padding:.35rem .7rem; border-radius:6px; text-decoration:none;
                  {{ m == metric ? 'background:var(--accent); color:var(--bg); font-weight:600' : 'color:var(--muted)' }}">
            {{ {pasos: 'Pasos', sueno: 'Sueño', cuerpo: 'Cuerpo', carga: 'Carga'}[m] }}</a>
        {% endfor %}
    </nav>
    <label>Desde <input type="date" name="desde" value="{{ from|date('Y-m-d') }}"></label>
    <label>Hasta <input type="date" name="hasta" value="{{ to|date('Y-m-d') }}"></label>
    <button type="submit">Aplicar</button>
</form>

{% if metric == 'pasos' %}
<div class="panel"><h2>Pasos por fuente</h2><canvas id="ch1"></canvas></div>
<div class="grid2">
    <div class="panel">
        <h2>Mapa de calor: pasos por hora y día <span class="muted" style="font-weight:400">(azul = Garmin, ámbar = móvil — tus turnos se pintan solos)</span></h2>
        {# table-layout:fixed reparte el ancho del panel a partes iguales entre
           las 24 columnas de horas (la de fechas queda fija), de modo que la
           cuadricula llena su panel en cualquier ancho de pantalla. #}
        <table style="table-layout:fixed; border-collapse:separate; border-spacing:1px; font-size:.6rem">
            <tr><th style="width:2.6em"></th>{% for h in 0..23 %}<th class="muted" style="padding:0; border:0; text-align:center; overflow:hidden">{{ h }}</th>{% endfor %}</tr>
            {% for day, hours in data.heatmap.rows %}
            <tr>
                <td class="muted" style="border:0; padding:1px 3px 1px 0; white-space:nowrap">{{ day|date('d/m') }}</td>
                {% for h in 0..23 %}
                    {% set cell = hours[h] ?? null %}
                    {% if cell and cell.steps > 0 %}
                        {% set alpha = 0.15 + 0.85 * (cell.steps / data.heatmap.max) %}
                        {% set isPhone = (cell.phone_steps ?? 0) >= (cell.garmin_steps ?? 0) %}
                        <td title="{{ day }} {{ h }}h: {{ cell.steps }} pasos ({{ isPhone ? 'móvil' : 'Garmin' }})"
                            style="height:13px; border:0; border-radius:1px; padding:0;
                                   background: rgba({{ isPhone ? '201,133,0' : '57,135,229' }}, {{ alpha|round(2) }})"></td>
                    {% else %}
                        <td style="height:13px; border:0; border-radius:1px; padding:0; background:var(--bg2)"></td>
                    {% endif %}
                {% endfor %}
            </tr>
            {% endfor %}
        </table>
    </div>
    {# flex:1 + height:0 no sirve aquí: la fila de .grid2 no tiene alto
       explícito (grid-auto-rows:auto), así que el grid mide la
       *max-content contribution* de cada panel para fijar el alto de la
       fila. flex-basis:0/height:0 solo se resuelven en el layout final,
       una vez el contenedor ya tiene un alto definido — no participan en
       ese cálculo intrínseco, así que el grid ve la tabla de 30 filas
       "sin colapsar" y estira la fila (y el heatmap con ella) a esa
       altura. max-height sí se respeta en el cálculo intrínseco, así que
       calculamos aquí la altura real del heatmap (filas × 14px de celda
       + spacing, más la cabecera) y la usamos como tope del scroll. #}
    {% set heatmapContentHeight = (data.heatmap.rows|length + 1) * 14 + 1 %}
    <div class="panel">
        <h2>Pasos por día</h2>
        <div style="overflow-y:auto; max-height:{{ heatmapContentHeight }}px">
        <table>
            <tr><th>Día</th><th>Pasos teléfono</th><th>Distancia móvil</th><th>Pasos Garmin</th><th>Objetivo</th><th>% objetivo</th></tr>
            {% for row in data.step_days %}
            <tr>
                <td>{{ row.day|date('d/m/Y') }}</td>
                <td>{{ row.phone_steps|number_format(0, ',', '.') }}</td>
                <td>
                    {%- if row.phone_distance_m is null -%}
                        —
                    {%- elseif row.phone_distance_m >= 1000 -%}
                        {{ (row.phone_distance_m / 1000)|number_format(1, ',') }} km
                    {%- else -%}
                        {{ row.phone_distance_m|number_format(0, ',', '.') }} m
                    {%- endif -%}
                </td>
                <td>{{ row.garmin_steps|number_format(0, ',', '.') }}</td>
                <td>{{ row.daily_goal|number_format(0, ',', '.') }}</td>
                <td>{{ row.pct_goal|round(0, 'common') }} %{{ row.goal_met ? ' ✓' }}</td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="muted">Sin datos en este rango.</td></tr>
            {% endfor %}
        </table>
        </div>
    </div>
</div>
{% elseif metric == 'sueno' %}
<div class="grid2">
    <div class="panel"><h2>Fases y score</h2><canvas id="ch1"></canvas></div>
    <div class="panel"><h2>Respiración y SpO2 nocturnos</h2><canvas id="ch2"></canvas></div>
</div>
{% elseif metric == 'cuerpo' %}
<div class="grid2">
    <div class="panel"><h2>Peso</h2><canvas id="ch1"></canvas></div>
    <div class="panel"><h2>% grasa, % agua, masa muscular y masa ósea</h2><canvas id="ch2"></canvas></div>
</div>
{% elseif metric == 'carga' %}
<div class="grid2">
    <div class="panel"><h2>FC reposo y estrés medio</h2><canvas id="ch1"></canvas></div>
    <div class="panel"><h2>HRV</h2><canvas id="ch2"></canvas></div>
</div>
<div class="panel"><h2>Minutos de intensidad / semana</h2><canvas id="ch3" style="max-height:220px"></canvas></div>
<div class="panel"><h2>VO2max</h2><canvas id="ch4"></canvas></div>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
const D = {{ data|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }};
const M = '{{ metric }}';
// Paleta validada contra CVD (daltonismo): slots de serie en orden fijo + colores de estado.
// Misma identidad que en el dashboard: Garmin = slot 1, Móvil = slot 3, fases de sueño 1-4, HRV = slot 1, peso diario = slot 1 / tendencia = slot 3.
const C = { s1:'#3987e5', s2:'#199e70', s3:'#c98500', s4:'#9085e9', s5:'#e66767',
            ok:'#0ca30c', warn:'#fab219', crit:'#d03b3b',
            muted:'#737c73', grid:'#2c2c2a', axis:'#383835', ink:'#c5c9c5', panel:'#282727' };
Chart.defaults.color = '#c5c9c5'; Chart.defaults.borderColor = C.axis;
Chart.defaults.scale.grid.color = C.grid;

if (M === 'pasos') {
    const days = D.by_source.map(r => r.day.slice(5));
    const goal = Object.fromEntries(D.daily.map(r => [r.day, +r.daily_goal]));
    new Chart(ch1, { options: { scales: { x: { stacked: true }, y: { stacked: true } } }, data: {
        labels: days,
        datasets: [
            { type: 'bar', label: 'Garmin', data: D.by_source.map(r => +r.garmin_steps || 0), backgroundColor: C.s1 },
            { type: 'bar', label: 'Móvil',  data: D.by_source.map(r => +r.phone_steps || 0), backgroundColor: C.s3 },
            { type: 'line', label: 'Objetivo', data: D.by_source.map(r => goal[r.day] ?? null),
              borderColor: C.ink, borderDash: [6, 4], pointRadius: 0, stepped: true },
        ]}});
}
if (M === 'sueno') {
    const days = D.sleep.map(r => r.day.slice(5));
    const ph = k => D.sleep.map(r => r[k] ? +(r[k]/3600).toFixed(2) : null);
    new Chart(ch1, { options: { scales: { x:{stacked:true}, y:{stacked:true,min:0,max:10}, y2:{position:'right',min:0,max:100,grid:{display:false}} } }, data: {
        labels: days,
        datasets: [
            { type:'bar', label:'Profundo', data: ph('deep_s'),  backgroundColor: C.s1, borderColor: C.panel, borderWidth: 2 },
            { type:'bar', label:'Ligero',   data: ph('light_s'), backgroundColor: C.s2, borderColor: C.panel, borderWidth: 2 },
            { type:'bar', label:'REM',      data: ph('rem_s'),   backgroundColor: C.s3, borderColor: C.panel, borderWidth: 2 },
            { type:'bar', label:'Despierto',data: ph('awake_s'), backgroundColor: C.s4, borderColor: C.panel, borderWidth: 2 },
            { type:'line', label:'Score', data: D.sleep.map(r => r.score), borderColor: C.ink, yAxisID:'y2', pointRadius:2 },
        ]}});
    new Chart(ch2, { type:'line', options:{ scales:{ y2:{position:'right',min:85,max:100,grid:{display:false}} } }, data: {
        labels: days,
        datasets: [
            { label:'Respiración (rpm)', data: D.sleep.map(r => r.respiration_avg ? +r.respiration_avg : null), borderColor: C.s1, pointRadius:2, spanGaps:true },
            { label:'SpO2 %', data: D.sleep.map(r => r.spo2_avg ? +r.spo2_avg : null), borderColor: C.s2, yAxisID:'y2', pointRadius:2, spanGaps:true },
        ]}});
}
if (M === 'cuerpo') {
    const days = D.body.map(r => r.day.slice(5));
    const peso = D.body.map(r => r.weight_kg ? +r.weight_kg : null);
    const ma7 = peso.map((_, i) => { const w = peso.slice(Math.max(0,i-6), i+1).filter(v => v !== null);
        return w.length >= 3 ? +(w.reduce((a,b)=>a+b,0)/w.length).toFixed(2) : null; });
    new Chart(ch1, { type:'line', data: { labels: days, datasets: [
        { label:'kg (día)', data: peso, borderColor: C.s1, pointRadius:2, borderWidth:1, spanGaps:true },
        { label:'Tendencia 7d', data: ma7, borderColor: C.s3, pointRadius:0, borderWidth:2.5, spanGaps:true }]}});
    new Chart(ch2, { type:'line', options:{ scales:{ y2:{position:'right',grid:{display:false}} } }, data: { labels: days, datasets: [
        { label:'% grasa', data: D.body.map(r => r.body_fat_pct ? +r.body_fat_pct : null), borderColor: C.s1, pointRadius:2, spanGaps:true },
        { label:'% agua', data: D.body.map(r => r.body_water_pct ? +r.body_water_pct : null), borderColor: C.s4, pointRadius:2, spanGaps:true },
        { label:'Músculo kg', data: D.body.map(r => r.muscle_mass_kg ? +r.muscle_mass_kg : null), borderColor: C.s2, yAxisID:'y2', pointRadius:2, spanGaps:true },
        { label:'Hueso kg', data: D.body.map(r => r.bone_mass_kg ? +r.bone_mass_kg : null), borderColor: C.s5, yAxisID:'y2', pointRadius:2, spanGaps:true }]}});
}
if (M === 'carga') {
    const days = D.daily.map(r => r.day.slice(5));
    new Chart(ch1, { type:'line', options:{ scales:{ y2:{position:'right',min:0,max:100,grid:{display:false}} } }, data: { labels: days, datasets: [
        { label:'FC reposo', data: D.daily.map(r => r.resting_hr), borderColor: C.s1, pointRadius:2, spanGaps:true },
        { label:'Estrés medio', data: D.daily.map(r => r.avg_stress), borderColor: C.s2, yAxisID:'y2', pointRadius:2, spanGaps:true }]}});
    const hd = Object.fromEntries(D.hrv.map(r => [r.day, r]));
    const hv = k => D.daily.map(r => hd[r.day] ? hd[r.day][k] : null);
    new Chart(ch2, { type:'line', data: { labels: days, datasets: [
        { label:'Base alta', data: hv('baseline_high_ms'), borderColor:'transparent', backgroundColor:'rgba(57,135,229,.22)', fill:'+1', pointRadius:0 },
        { label:'Base baja', data: hv('baseline_low_ms'), borderColor:'transparent', pointRadius:0 },
        { label:'HRV', data: hv('last_night_avg_ms'), borderColor: C.s1, pointRadius:3 }]},
        options:{ plugins:{ legend:{ labels:{ filter: i => i.text === 'HRV' } } } }});
    new Chart(ch3, { type:'bar', options:{ scales:{ x:{stacked:true}, y:{stacked:true} } }, data: {
        labels: D.intensity.map(r => r.week_start.slice(5)),
        datasets: [
            { label:'Moderados', data: D.intensity.map(r => +r.moderate), backgroundColor: C.s1 },
            { label:'Vigorosos ×2', data: D.intensity.map(r => +r.vigorous2), backgroundColor: C.s2 }]}});
    const vd = Object.fromEntries(D.vo2max.map(r => [r.day, r]));
    const vv = k => D.daily.map(r => vd[r.day] ? vd[r.day][k] : null);
    new Chart(ch4, { type:'line', data: { labels: days, datasets: [
        { label:'Carrera', data: vv('vo2max_running'), borderColor: C.s1, pointRadius:2, spanGaps:true },
        { label:'Ciclismo', data: vv('vo2max_cycling'), borderColor: C.s3, pointRadius:2, spanGaps:true }]}});
}
</script>
