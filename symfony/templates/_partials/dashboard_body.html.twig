{# Cuerpo del dashboard (semáforo, tarjetas, banner de mesociclo, resumen
   semanal, gráficas y últimas actividades), compartido entre
   dashboard/index.html.twig (propietario) y share/dashboard.html.twig
   (invitado de un enlace compartido).

   Variables esperadas:
     traffic, cards, mesocycle, meso_week, weekly, week_targets, activities,
     series, from, to
     routes         — {activities, detail, activity_show}: nombres de ruta
     route_params   — parámetros base para path() (p.ej. {token: ...} en la vista de invitado)
     sync           — estado de sincronización o null (el invitado nunca lo ve)
     diagnostics    — diagnóstico de dispositivos o null (el invitado nunca lo ve)
     steps_label, hrv_label, sleep_label — textos de tarjeta, opcionales
     range_note     — texto de la leyenda del pie de las gráficas, opcional
#}
{% set steps_label = steps_label|default('Pasos hoy') %}
{% set hrv_label = hrv_label|default('HRV anoche') %}
{% set sleep_label = sleep_label|default('Sueño anoche') %}
{% set range_note = range_note|default('Últimos 30 días') %}

{# ---------- Semáforo de recuperación ---------- #}
{% set tl_colors = {green: 'var(--ok)', amber: 'var(--warn)', red: 'var(--crit)', off: 'var(--muted)'} %}
<div class="panel" style="border-left: 6px solid {{ tl_colors[traffic.level] }}; display:flex; gap:1.2rem; align-items:center; flex-wrap:wrap;">
    <strong style="font-size:1.05rem">{{ traffic.message }}</strong>
    <span class="muted" style="margin-left:auto">
        {% if traffic.hrv_ms %}HRV {{ traffic.hrv_ms }} ms ({{ traffic.hrv_status|lower }}, base {{ traffic.hrv_base }}){% endif %}
        {% if traffic.sleep_h %} · Sueño {{ traffic.sleep_h }} h{% if traffic.sleep_score %}, score {{ traffic.sleep_score }}{% endif %}{% endif %}
    </span>
</div>

{# ---------- Tarjetas con contexto ---------- #}
<div class="cards">
    <a class="card" href="{{ path(routes.detail, route_params|merge({metric: 'pasos'})) }}" style="text-decoration:none; color:inherit">
        <div class="label">{{ steps_label }}</div>
        <div class="value">{{ cards.steps_today|number_format(0, ',', '.') }}</div>
        <div style="background:var(--bg2); border-radius:4px; height:6px; margin-top:.5rem; overflow:hidden">
            <div style="width:{{ cards.steps_pct }}%; height:100%; background:{{ cards.steps_pct >= 100 ? 'var(--ok)' : 'var(--warn)' }}"></div>
        </div>
        <div class="muted" style="font-size:.75rem; margin-top:.3rem">
            {{ cards.steps_pct >= 100 ? 'objetivo cumplido' : 'faltan ' ~ (cards.steps_goal - cards.steps_today)|number_format(0, ',', '.') }}
        </div>
    </a>
    <a class="card" href="{{ path(routes.activities, route_params) }}" style="text-decoration:none; color:inherit">
        <div class="label">Semana</div>
        <div class="value" style="font-size:1.15rem; line-height:1.9">
            <span class="{{ cards.week_strength >= cards.target_strength ? 'ok' : 'warn' }}">🏋 {{ cards.week_strength }}/{{ cards.target_strength }}</span><br>
            <span class="{{ cards.week_swim >= cards.target_swim ? 'ok' : 'warn' }}">🏊 {{ cards.week_swim }}/{{ cards.target_swim }}</span>
        </div>
    </a>
    <a class="card" href="{{ path(routes.detail, route_params|merge({metric: 'cuerpo'})) }}" style="text-decoration:none; color:inherit">
        <div class="label">Peso (tendencia)</div>
        <div class="value">{{ cards.weight_trend ?? '—' }}<span class="muted" style="font-size:.9rem"> kg</span></div>
        {% if cards.weight_delta is not null %}
        <div class="muted" style="font-size:.78rem">
            <span class="{{ cards.weight_delta <= 0 ? 'ok' : 'warn' }}">{{ cards.weight_delta > 0 ? '+' }}{{ cards.weight_delta|number_format(2, ',') }} kg/sem</span>
        </div>
        {% endif %}
    </a>
    <a class="card" href="{{ path(routes.detail, route_params|merge({metric: 'carga'})) }}" style="text-decoration:none; color:inherit">
        <div class="label">{{ hrv_label }}</div>
        <div class="value">{{ traffic.hrv_ms ? traffic.hrv_ms ~ ' ms' : '—' }}</div>
        <div class="muted" style="font-size:.78rem">base {{ traffic.hrv_base ?? '—' }}</div>
    </a>
    <a class="card" href="{{ path(routes.detail, route_params|merge({metric: 'sueno'})) }}" style="text-decoration:none; color:inherit">
        <div class="label">{{ sleep_label }}</div>
        <div class="value">{{ traffic.sleep_h ? traffic.sleep_h ~ ' h' : '—' }}</div>
        <div class="muted" style="font-size:.78rem">score {{ traffic.sleep_score ?? '—' }}</div>
    </a>
</div>

{# ---------- Banner de mesociclo ---------- #}
{% if mesocycle %}
<div class="panel" style="display:flex; gap:1.2rem; align-items:baseline; flex-wrap:wrap;">
    <strong style="color: var(--accent)">Mesociclo {{ mesocycle.id }} · {{ mesocycle.objective }}</strong>
    {% if meso_week %}<span>Semana {{ meso_week.current }}/{{ meso_week.total }}</span>{% endif %}
    <span class="muted">{{ mesocycle.date_from|date('d/m') }} → {{ mesocycle.date_to|date('d/m') }}</span>
    {% if sync is not null %}
    <span class="muted" style="margin-left:auto">
        App móvil: {{ sync['hc_app_last_sync'] is defined ? sync['hc_app_last_sync']|date('d/m H:i') : '—' }}
        · Garmin: {{ sync['garmin_sidecar_last_run'] is defined ? sync['garmin_sidecar_last_run']|date('d/m H:i') : '—' }}
    </span>
    {% endif %}
</div>
{% endif %}

{# ---------- Diagnóstico de dispositivos (solo propietario) ---------- #}
{% if diagnostics is not null %}
<div class="panel">
    <h2>Diagnóstico de sincronización</h2>
    <p class="muted" style="margin:0 0 .6rem">
        App móvil: {{ diagnostics.sync['hc_app_last_sync'] is defined ? diagnostics.sync['hc_app_last_sync']|date('d/m/Y H:i') : '—' }}
        · Garmin: {{ diagnostics.sync['garmin_sidecar_last_run'] is defined ? diagnostics.sync['garmin_sidecar_last_run']|date('d/m/Y H:i') : '—' }}
    </p>
    <table>
        <tr><th>Dispositivo</th><th>Última recepción</th><th>Buckets (7 días)</th></tr>
        {% for d in diagnostics.devices %}
        <tr>
            <td>{{ d.device }}</td>
            <td>{{ d.last_received ? d.last_received|date('d/m/Y H:i') : '—' }}</td>
            <td>{{ d.buckets_7d|number_format(0, ',', '.') }}</td>
        </tr>
        {% else %}
        <tr><td colspan="3" class="muted">Sin buckets registrados.</td></tr>
        {% endfor %}
    </table>
</div>
{% endif %}

{# ---------- Resumen semanal ---------- #}
<div class="panel">
    <h2>Semana a semana vs pauta</h2>
    <table>
        <tr>
            <th>Semana</th><th>Pasos/día</th><th>Días objetivo</th>
            <th>Fuerza</th><th>Natación</th><th>Peso medio</th><th>Δ peso</th>
            <th>Sueño</th><th>HRV</th>
        </tr>
        {% for w in weekly %}
        {% set wt = week_targets[w.week_start] ?? (mesocycle ? {strength: mesocycle.strength_sessions_week, swim: mesocycle.swim_sessions_week} : null) %}
        {% set okF = wt and w.strength_sessions >= wt.strength %}
        {% set okN = wt and w.swim_sessions >= wt.swim %}
        <tr>
            <td>{{ w.week_start|date('d/m') }}</td>
            <td>{{ w.avg_steps|number_format(0, ',', '.') }}</td>
            <td>{{ w.days_goal_met }}/{{ w.days_with_data }}</td>
            <td class="{{ okF ? 'ok' : 'warn' }}">{{ w.strength_sessions }}{% if wt %}/{{ wt.strength }}{% endif %}</td>
            <td class="{{ okN ? 'ok' : 'warn' }}">{{ w.swim_sessions }}{% if wt %}/{{ wt.swim }}{% endif %}
                {% if w.swim_m > 0 %}<span class="muted">({{ (w.swim_m / 1000)|number_format(1, ',') }} km)</span>{% endif %}</td>
            <td>{{ w.avg_weight ? w.avg_weight ~ ' kg' : '—' }}</td>
            <td>{% if w.weight_delta is not null %}
                <span class="{{ w.weight_delta <= 0 ? 'ok' : 'warn' }}">{{ w.weight_delta > 0 ? '+' }}{{ w.weight_delta|number_format(2, ',') }}</span>
                {% else %}—{% endif %}</td>
            <td>{{ w.avg_sleep_score ?? '—' }}</td>
            <td>{{ w.avg_hrv_ms ? w.avg_hrv_ms ~ ' ms' : '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="9" class="muted">Sin semanas con datos.</td></tr>
        {% endfor %}
    </table>
</div>

{# ---------- Gráficas del bloque (30 días fijos) ---------- #}
<p class="muted" style="margin:.2rem 0 .8rem">{{ range_note }} ({{ from|date('d/m') }} → {{ to|date('d/m') }}). Para otros rangos, usa las vistas de <a href="{{ path(routes.detail, route_params|merge({metric: 'pasos'})) }}" style="color:var(--link)">Detalle</a>.</p>

<div class="grid2">
    <div class="panel"><h2>Pasos por fuente y objetivo</h2><canvas id="chSteps"></canvas></div>
    <div class="panel"><h2>Sueño: fases y score</h2><canvas id="chSleep"></canvas></div>
    <div class="panel"><h2>HRV nocturna sobre banda base</h2><canvas id="chHrv"></canvas></div>
    <div class="panel"><h2>Peso: diario y tendencia 7d</h2><canvas id="chWeight"></canvas></div>
    <div class="panel"><h2>FC en reposo</h2><canvas id="chRhr"></canvas></div>
    <div class="panel"><h2>Minutos de intensidad / semana</h2><canvas id="chIntensity"></canvas></div>
</div>

{# ---------- Últimas actividades ---------- #}
<div class="panel">
    <h2>Últimas actividades <a href="{{ path(routes.activities, route_params) }}" style="float:right; font-size:.8rem; color:var(--link)">ver todas →</a></h2>
    <table>
        <tr><th>Fecha</th><th>Tipo</th><th>Nombre</th><th>Dur.</th><th>Dist.</th><th>FC</th><th>TE aer.</th><th>Carga</th></tr>
        {% for a in activities %}
        <tr>
            <td>{{ a.start_time|date('d/m H:i') }}</td>
            <td>{{ a.is_strength ? '🏋' : (a.activity_type starts with 'lap_swim' or 'swim' in a.activity_type ? '🏊' : '🏃') }} {{ a.activity_type }}</td>
            <td><a href="{{ path(routes.activity_show, route_params|merge({id: a.activity_id})) }}" style="color:var(--link)">{{ a.activity_name }}</a></td>
            <td>{{ a.duration_s ? (a.duration_s / 60)|round ~ "'" : '—' }}</td>
            <td>{{ a.distance_m ? (a.distance_m / 1000)|number_format(2, ',') ~ ' km' : '—' }}</td>
            <td>{{ a.avg_hr ?? '—' }}</td>
            <td>{{ a.te_aerobic ? a.te_aerobic|number_format(1, ',') : '—' }}</td>
            <td>{{ a.training_load ? a.training_load|round : '—' }}</td>
        </tr>
        {% else %}
        <tr><td colspan="8" class="muted">Sin actividades en el rango.</td></tr>
        {% endfor %}
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
const S = {{ series|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }};
// Paleta validada contra CVD (daltonismo): slots de serie en orden fijo + colores de estado.
const C = { s1:'#3987e5', s2:'#199e70', s3:'#c98500', s4:'#9085e9', s5:'#e66767',
            ok:'#12b76a', warn:'#f7a600', crit:'#ff5c4d',
            muted:'#8b98a5', grid:'#222a33', axis:'#2a333d', fg:'#dbe4ec', ink:'#dbe4ec', panel:'#1a2129' };
Chart.defaults.color = C.fg;
Chart.defaults.borderColor = C.axis;
Chart.defaults.scale.grid.color = C.grid;

const days  = S.steps.map(r => r.day.slice(5));
const byDay = (rows, key) => Object.fromEntries(rows.map(r => [r.day, r[key]]));
const align = (rows, key) => { const m = byDay(rows, key); return S.steps.map(r => m[r.day] ?? null); };

// 1) Pasos apilados por fuente + objetivo (una sola gráfica: cuánto y quién lo midió)
// Identidad de serie: Garmin = slot 1, Móvil = slot 3, Objetivo = línea de referencia neutra.
// La distancia recorrida con el móvil (phone_distance_m) no tiene serie propia
// aquí (unidad distinta a pasos): se muestra como línea extra del tooltip de
// "Móvil", igual que en la tabla de /detalle/pasos.
const phoneDistance = align(S.steps_source, 'phone_distance_m');
new Chart(chSteps, { options: { scales: { x: { stacked: true }, y: { stacked: true } },
    plugins: { tooltip: { callbacks: { afterLabel: (ctx) => {
        if (ctx.dataset.label !== 'Móvil') { return undefined; }
        const d = phoneDistance[ctx.dataIndex];
        if (!d) { return undefined; }
        return 'Distancia móvil: ' + (d >= 1000 ? (d / 1000).toFixed(1) + ' km' : Math.round(d) + ' m');
    } } } } }, data: {
    labels: days,
    datasets: [
        { type: 'bar', label: 'Garmin', data: align(S.steps_source, 'garmin_steps').map(v => +v || 0), backgroundColor: C.s1 },
        { type: 'bar', label: 'Móvil',  data: align(S.steps_source, 'phone_steps').map(v => +v || 0), backgroundColor: C.s3 },
        { type: 'line', label: 'Objetivo', data: S.steps.map(r => +r.daily_goal), borderColor: C.ink,
          borderDash: [6, 4], pointRadius: 0, stepped: true, borderWidth: 2 },
    ]}});

// 2) Sueño: fases apiladas (h) + score — ejes FIJOS para que nunca se rompa la escala
// Identidad de serie: Profundo = slot 1, Ligero = slot 2, REM = slot 3, Despierto = slot 4.
const ph = k => align(S.sleep, k).map(v => v ? +(v/3600).toFixed(2) : null);
new Chart(chSleep, { options: { scales: {
        x: { stacked: true },
        y: { stacked: true, min: 0, max: 10, title: { display: true, text: 'horas' } },
        y2: { position: 'right', min: 0, max: 100, grid: { display: false } } } }, data: {
    labels: days,
    datasets: [
        { type: 'bar', label: 'Profundo', data: ph('deep_s'),  backgroundColor: C.s1, borderColor: C.panel, borderWidth: 2 },
        { type: 'bar', label: 'Ligero',   data: ph('light_s'), backgroundColor: C.s2, borderColor: C.panel, borderWidth: 2 },
        { type: 'bar', label: 'REM',      data: ph('rem_s'),   backgroundColor: C.s3, borderColor: C.panel, borderWidth: 2 },
        { type: 'bar', label: 'Despierto',data: ph('awake_s'), backgroundColor: C.s4, borderColor: C.panel, borderWidth: 2 },
        { type: 'line', label: 'Score', data: align(S.sleep, 'score'), borderColor: C.ink,
          yAxisID: 'y2', pointRadius: 2, borderWidth: 2 },
    ]}});

// 3) HRV: banda base como área sombreada + puntos coloreados por estado (bien/desviado)
new Chart(chHrv, { type: 'line', data: {
    labels: days,
    datasets: [
        { label: 'Base alta', data: align(S.hrv, 'baseline_high_ms'), borderColor: 'transparent',
          backgroundColor: 'rgba(57,135,229,.22)', fill: '+1', pointRadius: 0 },
        { label: 'Base baja', data: align(S.hrv, 'baseline_low_ms'), borderColor: 'transparent', pointRadius: 0 },
        { label: 'HRV', data: align(S.hrv, 'last_night_avg_ms'), borderColor: C.s1, borderWidth: 2,
          pointRadius: 3, pointBackgroundColor: align(S.hrv, 'status').map(s =>
              !s ? C.muted : (s.toUpperCase() === 'BALANCED' ? C.ok : C.crit)) },
    ]}, options: { plugins: { legend: { labels: { filter: i => i.text === 'HRV' } } } }});

// 4) Peso: diario + tendencia 7d
new Chart(chWeight, { type: 'line', data: {
    labels: days,
    datasets: [
        { label: 'kg (día)', data: align(S.body, 'weight_kg').map(v => v ? +v : null), borderColor: C.s1, pointRadius: 2, borderWidth: 1, spanGaps: true },
        { label: 'Tendencia 7d', data: (() => {
            const pesoDiario = align(S.body, 'weight_kg').map(v => v ? +v : null);
            return pesoDiario.map((_, i) => {
                const win = pesoDiario.slice(Math.max(0, i - 6), i + 1).filter(v => v !== null);
                return win.length >= 3 ? +(win.reduce((a, b) => a + b, 0) / win.length).toFixed(2) : null;
            });
        })(), borderColor: C.s3, pointRadius: 0, borderWidth: 2.5, spanGaps: true },
    ]}});

// 5) FC reposo (serie única, sin leyenda)
new Chart(chRhr, { type: 'line', options: { plugins: { legend: { display: false } } }, data: {
    labels: days,
    datasets: [{ label: 'FC reposo', data: align(S.daily, 'resting_hr'), borderColor: C.s1, pointRadius: 2, spanGaps: true }]}});

// 6) Minutos de intensidad semanales (vigorosos ×2, criterio Garmin/OMS)
new Chart(chIntensity, { type: 'bar', options: { scales: { x: { stacked: true }, y: { stacked: true } } }, data: {
    labels: S.intensity.map(r => r.week_start.slice(5)),
    datasets: [
        { label: 'Moderados', data: S.intensity.map(r => +r.moderate), backgroundColor: C.s1 },
        { label: 'Vigorosos ×2', data: S.intensity.map(r => +r.vigorous2), backgroundColor: C.s2 },
    ]}});
</script>
