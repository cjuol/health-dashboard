{# Base común: paleta Kanagawa Dragon, navegación mínima. #}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Salud{% endblock %} · cjuol</title>
    {% include '_partials/styles.html.twig' %}
</head>
<body>
<header>
    <h1>⛰ Salud — Garmin + móvil</h1>
    <nav>
        <a href="{{ path('dashboard') }}" class="{{ app.current_route == 'dashboard' ? 'active' }}">Dashboard</a>
        <a href="{{ path('activities') }}" class="{{ app.current_route starts with 'activit' ? 'active' }}">Actividades</a>
        <a href="{{ path('detail', {metric: 'pasos'}) }}" class="{{ app.current_route == 'detail' ? 'active' }}">Detalle</a>
        <a href="{{ path('report_index') }}" class="{{ app.current_route starts with 'report' ? 'active' }}">Informes</a>
        <form method="post" action="{{ path('sync_garmin') }}" class="nav-sync">
            <input type="hidden" name="_token" value="{{ csrf_token('sync-garmin') }}">
            <button type="submit">⟳ Sync Garmin</button>
        </form>
        <span class="nav-session">
            <a href="{{ path('share_admin') }}" class="{{ app.current_route starts with 'share_admin' ? 'active' }}">Compartir</a>
            <a href="{{ path('perfil_index') }}" class="{{ app.current_route starts with 'perfil' ? 'active' }}">Perfil</a>
            <a href="{{ path('app_logout', {_csrf_token: csrf_token('logout')}) }}">Salir</a>
        </span>
    </nav>
</header>
<main>
    {% for message in app.flashes('error') %}<div class="flash">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('success') %}<div class="flash flash-success">{{ message }}</div>{% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
