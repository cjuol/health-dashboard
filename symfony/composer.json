{
    "name": "cjuol/health-dashboard",
    "description": "Dashboard de salud: fusión Garmin + móvil (Health Connect) e informes PDF para el entrenador",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo_pgsql": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/dbal": "^4.2",
        "symfony/console": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/http-client": "^7.2",
        "symfony/messenger": "^7.2",
        "symfony/runtime": "^7.2",
        "symfony/security-bundle": "^7.2",
        "symfony/security-csrf": "^7.2",
        "symfony/twig-bundle": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "config": {
        "allow-plugins": { "symfony/runtime": true },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "symfony/browser-kit": "^7.2",
        "symfony/css-selector": "^7.2"
    }
}
