# Copia a .env y ajusta. NO subir .env al repo.
APP_ENV=dev
APP_SECRET=cambia_esto_por_algo_aleatorio

# PostgreSQL con schema.sql + schema-fixes.sql + db/webapp.sql aplicados
DATABASE_URL="postgresql://health:health@db:5432/health?serverVersion=16&charset=utf8"

# Token que usa la app Android (vps.token en su local.properties)
MOVEMENT_API_TOKEN=el_mismo_bearer_que_en_la_app

# Sidecar Python que renderiza los PDF
SIDECAR_URL=http://sidecar:8000
SIDECAR_TOKEN=secreto_compartido_con_el_sidecar
